{
  "name": "rss-ticker-dashboard",
  "version": "1.0.0",
  "description": "Lightweight personal RSS news aggregation system with rule-based keyword classification and financial news terminal UI",
  "type": "module",
  "scripts": {
    "dev": "npm run build:standalone && vite",
    "build:standalone": "node scripts/build-standalone.mjs",
    "build": "npm run build:standalone && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "keywords": [
    "rss",
    "news-ticker",
    "news-dashboard",
    "rss-aggregator",
    "keyword-classification",
    "terminal"
  ],
  "author": "Ahmed Elsherbiny",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
